# Copy to .env.local and fill in. A web OAuth client id is public (not a secret).
# Create one at https://console.cloud.google.com/ → Google Auth Platform → Clients → Web application,
# with Authorised JavaScript origins http://localhost:5173 and http://localhost (see README).
VITE_GOOGLE_CLIENT_ID=739199653908-o3q86un2q6d1rrv1u03tvflgo09f93sn.apps.googleusercontent.com

# Optional shared workspace. Set both to use Supabase Auth, Postgres and Realtime.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
